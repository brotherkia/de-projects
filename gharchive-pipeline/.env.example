# Copy to .env and edit if these host ports are already taken on your machine.
#   cp .env.example .env
# Compose reads .env automatically. It is gitignored, so your local port choice
# stays local.

# Airflow web UI (http://localhost:<this>)
AIRFLOW_PORT=8080

# analytics-db, for connecting with psql/DBeaver from the host
ANALYTICS_DB_PORT=5432
