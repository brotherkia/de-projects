# Copy to .env, then fill in the two secrets below.
#   cp .env.example .env
# Compose reads .env automatically. It is gitignored, so your local secrets and
# port choices stay local -- nothing here is ever committed.
#
# ./setup.sh writes this file for you with freshly generated secrets, so you
# only need to do it by hand if you are setting the pipeline up on its own.

# --- Secrets. Required: compose refuses to start without them. -------------
# Generate a fresh value for each, independently:
#   python3 -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
#
# FERNET_KEY encrypts the connection passwords Airflow stores in its metadata
# DB. Changing it later makes existing stored connections undecryptable, so
# set it once, before first start, and keep it.
AIRFLOW__CORE__FERNET_KEY=
# Signs the API's JWTs. Safe to rotate whenever; it only invalidates sessions.
AIRFLOW__API_AUTH__JWT_SECRET=

# --- Host ports. Optional: edit only if these are already taken here. -------

# Airflow web UI (http://localhost:<this>)
AIRFLOW_PORT=8080

# analytics-db, for connecting with psql/DBeaver from the host
ANALYTICS_DB_PORT=5432
